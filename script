local Players = game:GetService("Players") local LocalPlayer = Players.LocalPlayer print("--- SEARCHING PLAYERGUI FOR MINIGAME ELEMENTS ---") local gui = LocalPlayer:FindFirstChild("PlayerGui") if gui then for _, v in pairs(gui:GetDescendants()) do if v:IsA("GuiObject") and v.Visible then print("Found Visible UI:", v.Name, "| Parent:", v.Parent.Name, "| Class:", v.ClassName) end end end print("--- SEARCH COMPLETE ---")
